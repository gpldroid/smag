---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const rest = articles.filter((article) => article.id !== featured?.id);
const categories = ['World', 'Technology', 'Business', 'Culture', 'Lifestyle'];
---
<BaseLayout title="Independent ideas for a changing world" description="SMAG brings together the latest stories, thoughtful analysis and essential perspectives.">
  <section class="hero wrap">
    <div class="hero-kicker"><span class="live-dot"></span> THE EDITORIAL FRONT PAGE <span>VOL. 01 / NO. 01</span></div>
    {featured ? <div class="hero-grid">
      <div class="hero-copy"><p class="eyebrow">{featured.data.category} <span>·</span> {featured.data.type}</p><h1>{featured.data.title}</h1><p class="hero-description">{featured.data.description}</p><div class="byline"><span>By {featured.data.author}</span><span>·</span><time>{featured.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></div><a class="text-link" href={`/articles/${featured.id}/`}>Read the story <span>↗</span></a></div>
      <a class="hero-image" href={`/articles/${featured.id}/`}><img src={featured.data.cover} alt={featured.data.coverAlt} fetchpriority="high" /><span>FEATURED STORY</span></a>
    </div> : <div class="empty-state"><h1>Stories with substance.</h1><p>Add your first Markdown article to <code>src/content/articles/</code> to populate the front page.</p></div>}
  </section>
  <section class="wrap latest-section">
    <div class="section-heading"><div><p class="section-kicker">FRESH PERSPECTIVES</p><h2>Latest stories<span>.</span></h2></div><a href="/search/" class="text-link">Explore all stories ↗</a></div>
    {rest.length ? <div class="story-grid">{rest.slice(0, 6).map((article, index) => <ArticleCard article={article} variant={index === 0 ? 'feature' : 'standard'} />)}</div> : <p class="muted">More stories are on the way.</p>}
  </section>
  <section class="category-strip"><div class="wrap category-inner"><span>EXPLORE TOPICS</span>{categories.map((category) => <a href={`/category/${category.toLowerCase()}/`}>{category} ↗</a>)}</div></section>
  <section class="wrap editor-note"><div><p class="section-kicker">THE SMAG POINT OF VIEW</p><h2>Curiosity is a good place to start.</h2></div><p>We believe the best stories do more than report what happened. They help explain why it matters.</p></section>
</BaseLayout>